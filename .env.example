# Copy to .env.local for local dev, and add the same values in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API Keys (new keys, not "Legacy"): publishable = sb_publishable_…, secret = sb_secret_…
# Project URL: Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Shared password readers enter to see private materials
READER_PASSWORD=

# Long random string used to sign the reader cookie (e.g. `openssl rand -hex 32`)
READER_COOKIE_SECRET=

# Vercel sends this automatically to cron jobs; any random string (e.g. `openssl rand -hex 16`)
CRON_SECRET=

# Public site URL (used in login email links). Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
